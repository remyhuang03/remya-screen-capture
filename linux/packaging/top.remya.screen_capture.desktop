[Desktop Entry]
Type=Application
Name=Remy'a Screen Capture
Comment=Screen capture tool for Hyprland
Exec=remya_screen_capture
Icon=top.remya.screen_capture
Terminal=false
Categories=Utility;Graphics;
StartupWMClass=top.remya.screen_capture
Actions=PickColor;settings;

[Desktop Action PickColor]
Name=Pick color
Exec=remya_screen_capture --color-picker

[Desktop Action settings]
Name=Settings
Exec=remya_screen_capture --settings
